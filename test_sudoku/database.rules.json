{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "recent_players": {
          ".indexOn": ["timestamp"]
        }
      }
    },
    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "game_invites": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["fromUid", "toUid", "status"]
    },
    "matchmaking": {
      "$league": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["difficulty", "timestamp", "matched", "gameMode", "level"]
      }
    },
    "leaderboard": {
      "multiplayer": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["level", "totalScore", "winRate"]
      },
      "daily": {
        "$date": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["level", "totalScore"]
        }
      },
      "weekly": {
        "$week": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["level", "totalScore"]
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('friendRequests').child($uid).child(auth.uid).exists())",
        ".write": "auth != null"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "nicknames": {
      "$nickname": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "invite_blocks": {
      "$blockKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
